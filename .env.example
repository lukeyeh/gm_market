# Copy to .env and fill in. direnv loads it; see the README for running
# without direnv.

# This bot's own token, from the Discord Developer Portal: a different
# application from gm_bot's. Required.
DISCORD_TOKEN=

# The GM channels gm_bot watches, one per server, separated by commas: the
# same list as gm_bot's. Required.
GM_CHANNEL_IDS=

# gm_bot's ledger, which says what counts as a GM. Required.
GM_DATABASE=/path/to/gm.db

# Whose midnight separates one day from the next. Must be gm_bot's. UTC if
# empty.
TIMEZONE=America/New_York

# Where to keep predictions.db. Give an absolute path when using `bazel run`,
# which starts the bot somewhere inside Bazel's output tree.
DATA_DIR=
